# Este arquivo substitui o _headers que o vinext gera sozinho, então a regra
# de cache dos assets com hash no nome precisa continuar aqui embaixo.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/icons/*
  Cache-Control: public, max-age=604800

# Cache content-hashed assets immutably (originalmente gerado pelo vinext)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# titan.js — os 382 KB do aplicativo, que saíram de dentro de titan.html em
# 19/08/2026. Deliberadamente NÃO é "immutable": este site não tem pipeline
# de build que coloque hash no nome do arquivo, então cache imutável dependeria
# de alguém lembrar de trocar o ?v= a cada alteração. Esquecer uma vez serve
# JavaScript velho com HTML novo — falha pior do que o desperdício que estamos
# corrigindo.
#
# no-cache não quer dizer "não guarde": o navegador guarda e pergunta ao
# servidor se mudou. Quando não mudou, a resposta é um 304 de alguns bytes em
# vez dos 382 KB. É o ganho que interessa, e por construção nunca serve versão
# defasada.
/titan.js
  Cache-Control: public, no-cache
  Content-Type: application/javascript; charset=utf-8

# Mesma regra para o HTML: ele mudou de 543 KB para 161 KB, e precisa ser
# sempre o mais recente porque é ele que aponta para a versão do JS.
/titan.html
  Cache-Control: public, no-cache
